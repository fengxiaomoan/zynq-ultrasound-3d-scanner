# V2.3.2 static mapping. ADC V1.2 continuity/electrical state still require hardware verification.
set_property PACKAGE_PIN U18 [get_ports sys_clk]
set_property IOSTANDARD LVCMOS33 [get_ports sys_clk]
create_clock -name sys_clk -period 20.000 [get_ports sys_clk]
set_property PACKAGE_PIN N16 [get_ports sys_rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports sys_rst_n]
set_property PACKAGE_PIN K14 [get_ports tx_burst]
set_property IOSTANDARD LVCMOS33 [get_ports tx_burst]
set_property PACKAGE_PIN V15 [get_ports {ad1_data[0]}]
set_property PACKAGE_PIN W15 [get_ports {ad1_data[1]}]
set_property PACKAGE_PIN W14 [get_ports {ad1_data[2]}]
set_property PACKAGE_PIN Y14 [get_ports {ad1_data[3]}]
set_property PACKAGE_PIN V12 [get_ports {ad1_data[4]}]
set_property PACKAGE_PIN W13 [get_ports {ad1_data[5]}]
set_property PACKAGE_PIN U14 [get_ports {ad1_data[6]}]
set_property PACKAGE_PIN U15 [get_ports {ad1_data[7]}]
set_property PACKAGE_PIN V13 [get_ports {ad1_data[8]}]
set_property PACKAGE_PIN U13 [get_ports {ad1_data[9]}]
set_property PACKAGE_PIN V11 [get_ports {ad2_data[0]}]
set_property PACKAGE_PIN V10 [get_ports {ad2_data[1]}]
set_property PACKAGE_PIN W10 [get_ports {ad2_data[2]}]
set_property PACKAGE_PIN W9 [get_ports {ad2_data[3]}]
set_property PACKAGE_PIN Y9 [get_ports {ad2_data[4]}]
set_property PACKAGE_PIN Y8 [get_ports {ad2_data[5]}]
set_property PACKAGE_PIN Y7 [get_ports {ad2_data[6]}]
set_property PACKAGE_PIN Y6 [get_ports {ad2_data[7]}]
set_property PACKAGE_PIN W6 [get_ports {ad2_data[8]}]
set_property PACKAGE_PIN V6 [get_ports {ad2_data[9]}]
set_property PACKAGE_PIN W11 [get_ports {ad1_oe}]
set_property PACKAGE_PIN Y11 [get_ports {ad1_otr}]
set_property PACKAGE_PIN Y13 [get_ports {ad1_clk}]
set_property PACKAGE_PIN T9 [get_ports {ad2_oe}]
set_property PACKAGE_PIN U10 [get_ports {ad2_otr}]
set_property PACKAGE_PIN U9 [get_ports {ad2_clk}]
set_property IOSTANDARD LVCMOS33 [get_ports {ad1_data[*] ad2_data[*] ad1_otr ad2_otr ad1_clk ad2_clk ad1_oe ad2_oe lift_coils[*] ball_coils[*]}]
set_property DRIVE 8 [get_ports {tx_burst ad1_clk ad2_clk ad1_oe ad2_oe lift_coils[*] ball_coils[*]}]
set_property SLEW SLOW [get_ports {tx_burst ad1_clk ad2_clk ad1_oe ad2_oe lift_coils[*] ball_coils[*]}]
set_property PACKAGE_PIN M19 [get_ports {lift_coils[0]}]
set_property PACKAGE_PIN M20 [get_ports {lift_coils[1]}]
set_property PACKAGE_PIN U20 [get_ports {lift_coils[2]}]
set_property PACKAGE_PIN T20 [get_ports {lift_coils[3]}]
set_property PACKAGE_PIN N18 [get_ports {ball_coils[0]}]
set_property PACKAGE_PIN P19 [get_ports {ball_coils[1]}]
set_property PACKAGE_PIN N17 [get_ports {ball_coils[2]}]
set_property PACKAGE_PIN P18 [get_ports {ball_coils[3]}]
# Forwarded 5MHz ADC clock, data captured just BEFORE the next external update.
create_generated_clock -name adc_clk_out -source [get_ports sys_clk] -divide_by 10 [get_ports ad1_clk]
create_generated_clock -name adc_clk2_out -source [get_ports sys_clk] -divide_by 10 [get_ports ad2_clk]
# ADC tOD=25ns TYPICAL (no max in datasheet). 100ns is an engineering diagnostic budget,
# inclusive of clock route + board roundtrip + output settling; NOT a guaranteed measured bound.
set adc_ports [get_ports {ad1_data[*] ad2_data[*] ad1_otr ad2_otr}]
set_input_delay -clock adc_clk_out -max 100.000 [get_ports {ad1_data[*] ad1_otr}]
set_input_delay -clock adc_clk_out -min 0.000 [get_ports {ad1_data[*] ad1_otr}]
set_input_delay -clock adc_clk2_out -max 100.000 [get_ports {ad2_data[*] ad2_otr}]
set_input_delay -clock adc_clk2_out -min 0.000 [get_ports {ad2_data[*] ad2_otr}]
set adc_capture [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ acq/sample1_reg* || NAME =~ acq/sample2_reg* || NAME =~ acq/sample_otr_reg* || NAME =~ acq/diff_reg*)}]
# CE adc_phase==0 captures every 10 sys_clk cycles, on the next external launch boundary.
set_multicycle_path -setup 10 -end -from $adc_ports -to $adc_capture
set_multicycle_path -hold 9 -end -from $adc_ports -to $adc_capture
set_false_path -from [get_ports sys_rst_n] -to [get_cells -hier -filter {NAME =~ *reset_pipe_reg*}]
# No synchronous receiver on TX/OE/motor outputs. These have no output_delay.
